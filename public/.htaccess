# ============================================================
# بوابة جمعية القصيم التقنية — إعدادات Apache
# يُرفع مع محتويات مجلد dist إلى الاستضافة
# ============================================================

# --- توجيه مسارات التطبيق أحادي الصفحة (SPA) ---
# أي رابط لا يطابق ملفاً حقيقياً يُعرض عبر index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # لا تلمس الملفات والمجلدات الموجودة فعلاً
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # كل ما عدا ذلك -> index.html
  RewriteRule . /index.html [L]
</IfModule>

# --- ضغط الملفات لتسريع التحميل ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- تخزين مؤقت للأصول (أسماؤها تحمل بصمة فتتحدث تلقائياً) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  # الصفحة نفسها لا تُخزَّن حتى تظهر التحديثات فوراً
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# --- ترميز عربي سليم ---
AddDefaultCharset UTF-8

# --- منع عرض محتويات المجلدات ---
Options -Indexes
